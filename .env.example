# SD Dialer - Environment Variables
# Copiar para .env.local e preencher com as credenciais reais

# ============================================
# SUPABASE CONFIGURATION
# ============================================
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ============================================
# DEVELOPMENT
# ============================================
NEXT_PUBLIC_DEV_SUPABASE_REDIRECT_URL=http://localhost:3000/auth/callback

# ============================================
# PRODUCTION (Vercel)
# ============================================
# NEXT_PUBLIC_SUPABASE_REDIRECT_URL=https://your-domain.com/auth/callback

# ============================================
# PWA CONFIGURATION
# ============================================
NEXT_PUBLIC_APP_NAME=SD Dialer
NEXT_PUBLIC_APP_VERSION=1.0.0


# ============================================
# LUMIN DECISION ENGINE (optional)
# ============================================
# Prefer the open-source Kev TypeSafe-compatible server when configured.
# Example: https://your-kev-host.example.com or http://127.0.0.1:8008 in local development.
# KEV_SYSTEM_ONE_URL=http://127.0.0.1:8008
# KEV_API_KEY=optional-server-key
# KEV_MODEL=kev-latest

# Hosted Jev fallback (optional; used only when Kev is not configured)
# JEV_API_KEY=jv_live_xxx
# JEV_DECIDE_URL=https://jevtypesafeai.com/api/v1/decide
# JEV_MODEL=jev-latest

# If neither Kev nor Jev is configured, Creator Intelligence uses the existing GROQ_API_KEY.
# LUMIN_DECISION_FALLBACK_MODEL=openai/gpt-oss-120b
