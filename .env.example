# SD Dialer - Environment Variables
# Copiar para .env.local e preencher com as credenciais reais

# SUPABASE
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# DEVELOPMENT
NEXT_PUBLIC_DEV_SUPABASE_REDIRECT_URL=http://localhost:3000/auth/callback

# PRODUCTION
# NEXT_PUBLIC_SUPABASE_REDIRECT_URL=https://your-domain.com/auth/callback

# PWA
NEXT_PUBLIC_APP_NAME=SD Dialer
NEXT_PUBLIC_APP_VERSION=1.0.0

# LUMIN GSM BRIDGE
# Endpoint HTTPS do bridge que entrega a ordem ao Android/Samsung + SIM.
LUMIN_GSM_BRIDGE_URL=https://your-lumin-bridge.example.com/api/call
LUMIN_GSM_BRIDGE_KEY=replace-with-a-long-random-secret
