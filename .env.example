# SD Dialer - Environment Variables
# Copy to .env.local and fill in the real credentials.

# ============================================
# SUPABASE CONFIGURATION
# ============================================
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only key used by protected API routes. Never prefix this with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ============================================
# LUMIN VOICE AGENT
# ============================================
# Use the same private secret in the Lumin Railway service as SD_DIALER_VOICE_LEAD_API_KEY.
LUMIN_VOICE_LEAD_API_KEY=replace-with-a-long-random-secret

# Tenant that receives phone leads; falls back to LUMIN_DEFAULT_COMPANY_ID or REBORN_DEFAULT_COMPANY_ID.
LUMIN_VOICE_DEFAULT_COMPANY_ID=

# ============================================
# DEVELOPMENT
# ============================================
NEXT_PUBLIC_DEV_SUPABASE_REDIRECT_URL=http://localhost:3000/auth/callback

# ============================================
# PRODUCTION (Vercel)
# ============================================
# NEXT_PUBLIC_SUPABASE_REDIRECT_URL=https://your-domain.com/auth/callback

# ============================================
# PWA CONFIGURATION
# ============================================
NEXT_PUBLIC_APP_NAME=SD Dialer
NEXT_PUBLIC_APP_VERSION=1.0.0
